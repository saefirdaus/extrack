# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=extrack_db

# Environment variables untuk Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=extrack_db

# Database Connection URL (kompatibel untuk Prisma, Drizzle, TypeORM, node-postgres, dll.)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ==========================================
# JWT CONFIGURATION (Access Token Only)
# ==========================================
# Catatan: Refresh token tidak digunakan
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_random
JWT_EXPIRES_IN=1d
JWT_ALGORITHM=HS256
